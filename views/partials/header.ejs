<%- include('head') %>
<body>
<header class="site-header">
  <div class="container header-row">
    <a href="/" class="logo"><%= siteName %><span>.</span></a>
    <nav class="main-nav">
      <a href="/shop" class="<%= currentPath === '/shop' ? 'active' : '' %>">فروشگاه</a>
      <a href="/shop?sale=1" class="<%= (typeof filters !== 'undefined' && filters.onSale) ? 'active' : '' %>">تخفیف‌دارها</a>
    </nav>
    <form class="search-form" action="/shop" method="get" role="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input class="input" type="search" name="q" placeholder="جستجوی محصول، برند…" value="<%= typeof filters !== 'undefined' ? filters.q : '' %>">
    </form>
  </div>
  <div class="cat-bar">
    <div class="container">
      <% allSections.forEach(s => { %>
        <a class="chip section-chip <%= (typeof filters !== 'undefined' && filters.section === s.slug && !filters.cat) ? 'active' : '' %>" href="/shop?section=<%= encodeURIComponent(s.slug) %>"><%= s.emoji || '' %> <%= s.name %></a>
      <% }) %>
      <span class="chip-sep"></span>
      <% allCategories.forEach(c => { %>
        <a class="chip <%= (typeof filters !== 'undefined' && filters.cat === c.slug) ? 'active' : '' %>" href="/shop?cat=<%= encodeURIComponent(c.slug) %>"><%= c.name %></a>
      <% }) %>
    </div>
  </div>
</header>
<main class="container">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.text %></div><% } %>
