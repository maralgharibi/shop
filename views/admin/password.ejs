<%- include('_layout-top') %>
<div class="admin-top"><h1>تغییر رمز عبور</h1></div>
<div class="panel" style="max-width:420px">
  <form action="/admin/password" method="post">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field"><span>رمز فعلی</span><input class="input" type="password" name="current" required dir="ltr" autocomplete="current-password"></label>
    <label class="field"><span>رمز جدید <small>(حداقل ۶ کاراکتر)</small></span><input class="input" type="password" name="next" required minlength="6" dir="ltr" autocomplete="new-password"></label>
    <label class="field"><span>تکرار رمز جدید</span><input class="input" type="password" name="confirm" required minlength="6" dir="ltr" autocomplete="new-password"></label>
    <button class="btn">ذخیره رمز جدید</button>
  </form>
</div>
<%- include('_layout-bottom') %>
